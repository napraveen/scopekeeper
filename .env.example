# Switch Server & Agent Credentials
SWITCH_BASE_URL=http://localhost:8000
SWITCH_WS_URL=ws://localhost:8000
SWITCH_REGISTRATION_KEY=
CLERK_AGENT_ID=
CLERK_API_KEY=

# Scout Mode ("console" for OpenCode via Switch Console, or "builtin" for fallback)
SCOUT_MODE=console
SCOUT_AGENT_ID=
SCOUT_API_KEY=

# LLM Provider ("gemini", "anthropic", "openai", or "scripted" for offline tests)
LLM_PROVIDER=scripted
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_FAST=gemini-2.5-flash
LLM_MODEL_WRITER=gemini-2.5-pro

# Database & Local Paths
DATABASE_URL=sqlite:///./scopekeeper.db
DEMO_REPO_PATH=./demo-app/acme-portal

# Git Host ("local" or "github")
GIT_HOST=local
GITHUB_TOKEN=
GITHUB_REPO=pixel-and-co/acme-portal

# Preview Server
PREVIEW_PROVIDER=local
PREVIEW_BASE_URL=http://localhost:4300

# API & Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_TOKEN=sk-admin-dev-token

# Demo & Clock Controls
DEMO_MODE=true
CLOCK_START=2026-11-05T19:00:00+05:30
LOG_LEVEL=info
